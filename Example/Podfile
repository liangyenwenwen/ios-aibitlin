  pod 'OUILive', :path => '../'
#  pod 'OUIOrganization', :path => '../'
  pod 'OUIMoments', :path => '../'
  pod 'OpenIMSDK', :path => '../OpenIMSDK'
  pod 'ISEmojiView', :path => '../3rd'
  pod 'InputBarAccessoryView', :path => '../3rd'
  pod 'ZLPhotoBrowser', :path => '../3rd'
  pod 'ZFPlayer', :path => '../3rd'
#  pod 'LiveKitClient', :git => 'https://github.com/livekit/client-sdk-swift.git', :tag => '1.1.6'
  
  pod 'Localize-Swift', '~> 3.2'
  pod 'RxGesture', '~> 4.0.4'
  pod 'ProgressHUD', :git => 'https://github.com/std-s/ProgressHUD.git'
  pod 'MMBAlertsPickers'
  pod 'SGCodeTextField'
