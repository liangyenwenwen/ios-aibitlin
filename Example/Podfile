# 开启会议后有屏幕分享功能才会使用该target
target 'ScreenShareBroadcastExtension' do
#  pod 'LiveKitClient', :git => 'https://github.com/livekit/client-sdk-swift.git', :tag => '1.1.6'
#  pod 'LiveKitClient', :git => 'https://github.com/livekit/client-sdk-swift.git', :tag => '2.0.14'
#  pod 'LiveKitWebRTC', :git => 'https://github.com/livekit/webrtc-xcframework.git', :tag => '125.6422.07'
end

post_install do |installer|
  app_project = Xcodeproj::Project.open('OpenIMSDKUIKit.xcodeproj')
    app_project.native_targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings['OTHER_SWIFT_FLAGS'] = ['$(inherited)', '-D', 'COCOAPODS',
          '-D', 'ENABLE_MOMENTS', #开启朋友圈
          '-D', 'ENABLE_CALL'
          ]
        end
    end
  app_project.save
  
 installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
          config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
#          config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
          config.build_settings['ENABLE_BITCODE'] = 'NO'
          config.build_settings['EXPANDED_CODE_SIGN_IDENTITY'] = ""
          config.build_settings['CODE_SIGNING_REQUIRED'] = "NO"
          config.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
                
          # 'ENABLE_CALL', 'ENABLE_MOMENTS', 'ENABLE_LIVE_ROOM', 'ENABLE_ORGANIZATION'
          # 开启某个功能需要更改上一级spec文件中的引用关系
          if target.name == 'OUIIM'
            config.build_settings['OTHER_SWIFT_FLAGS'] = ['$(inherited)',
            '-D', 'COCOAPODS',
            '-D', 'ENABLE_MOMENTS',
            '-D', 'ENABLE_CALL', # 开启音视频
            '-D', 'ENABLE_LIVE_ROOM' # 开启会议
#            '-D', 'ENABLE_ORGANIZATION', # 开启组织架构
            ]
          end
          
          if target.name == 'OUICore'
            config.build_settings['OTHER_SWIFT_FLAGS'] = ['$(inherited)',
            '-D', 'COCOAPODS',
            '-D', 'ENABLE_CALL', # 开启音视频
            '-D', 'ENABLE_LIVE_ROOM' # 开启会议
            ]
          end
#
#          # 如果开启组织架构，需要设置此处
#          if target.name == 'OUICoreView'
#            config.build_settings['OTHER_SWIFT_FLAGS'] = ['$(inherited)',
#            '-D', 'COCOAPODS',
##            '-D', 'ENABLE_ORGANIZATION' # 开启组织架构
#            ]
#          end
#
          if target.name == 'LiveKitClient'
              # 开启会议后有屏幕分享功能才会使用该target
              config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = "NO"
              target.build_configurations.each do |config|
                config.build_settings['OTHER_SWIFT_FLAGS'] ||= ['$(inherited)']
                config.build_settings['OTHER_SWIFT_FLAGS'] << '-enable-experimental-feature AccessLevelOnImport'
              end
            end
    end
  end
end
