CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/LiveKitClient-iOS17.5" "${PODS_CONFIGURATION_BUILD_DIR}/Logging-iOS17.5" "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC-iOS17.5" "${PODS_CONFIGURATION_BUILD_DIR}/PromisesSwift-iOS17.5" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftProtobuf-iOS17.5" "${PODS_ROOT}/WebRTC-SDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/WebRTC-SDK"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/LiveKitClient-iOS17.5/LiveKitClient.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Logging-iOS17.5/Logging.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC-iOS17.5/FBLPromises.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/PromisesSwift-iOS17.5/Promises.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftProtobuf-iOS17.5/SwiftProtobuf.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks' '@executable_path/../../Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/LiveKitClient-iOS17.5/LiveKitClient.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Logging-iOS17.5/Logging.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC-iOS17.5/FBLPromises.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/PromisesSwift-iOS17.5/Promises.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/SwiftProtobuf-iOS17.5/SwiftProtobuf.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/LiveKitClient-iOS17.5" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Logging-iOS17.5" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC-iOS17.5" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/PromisesSwift-iOS17.5" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/SwiftProtobuf-iOS17.5" -iframework "${PODS_ROOT}/WebRTC-SDK" -iframework "${PODS_XCFRAMEWORKS_BUILD_DIR}/WebRTC-SDK"
OTHER_LDFLAGS = $(inherited) -framework "FBLPromises" -framework "LiveKitClient" -framework "Logging" -framework "Promises" -framework "SwiftProtobuf" -framework "WebRTC"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
